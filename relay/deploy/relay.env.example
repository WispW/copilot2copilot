# talk2copilot 中继服务配置
# 安装位置：/etc/talk2copilot-relay.env（权限 600）
# 改动后执行：systemctl restart talk2copilot-relay

# 监听端口
PORT=8787

# 监听地址：内网各机直连填 0.0.0.0（隧道接入与局域网直连同时可用，同一份在线名单）；
# 只允许反向代理 / 隧道访问时填 127.0.0.1（避免内网直接暴露）
# 局域网直连地址形如 ws://<本机内网 IP>:8787，中继启动日志会打印可用的地址
HOST=0.0.0.0

# 预共享密码：客户端在「连接 → 中继模式」里填同一字符串。
# 留空表示不校验，仅建议在完全可信的内网这样做。
TALK2COPILOT_TOKEN=change-me

# 管理令牌（可选）：留空则管理功能整体关闭。
# 在扩展配置界面「连接 → 中继管理令牌」填入同一字符串，即可获得中继管理权限
# （查看在线设备、踢出、封禁/解封；并管理所有房间与分类）。
TALK2COPILOT_ADMIN_TOKEN=

# 手机专用令牌（可选）：留空则手机端整体无法接入（4009）。
# 手机 App 以人工终端（x-client-kind: mobile）接入时必须携带同一串；
# 中继据此签发 mobile 身份，避免持普通令牌的客户端自称手机绕过写权限授权。
# 安装脚本首次部署会随机生成，就地升级时缺则自动补齐。
TALK2COPILOT_MOBILE_TOKEN=

# 封禁名单落盘路径（可选）：默认取 systemd STATE_DIRECTORY（/var/lib/talk2copilot-relay）下的 bans.json
#TALK2COPILOT_BAN_FILE=/var/lib/talk2copilot-relay/bans.json

# 房间 / 分类状态落盘路径（可选）：默认取同一目录下的 rooms.json，重启后房间与成员保留
#TALK2COPILOT_ROOMS_FILE=/var/lib/talk2copilot-relay/rooms.json

# 日志级别：error | warn | info | debug
LOG_LEVEL=info
