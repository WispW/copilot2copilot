.vscode/**
src/**
node_modules/**
relay/**
esbuild.mjs
tsconfig.json
.gitignore
# 打包产物目录（历史 vsix 与临时附件），绝不能进扩展包
vsix/**
# 本机自用的发布脚本（不入库），不能被打进扩展包
publish.sh
# 本机 AI Agent 约定文件，不打进扩展包
AGENTS.md
# 本机审阅 / PR / 发布临时文件（不入库，也不进扩展包）
.review-body.txt
.pr-body.txt
.commit-msg.txt
.release-notes.md
# 本地测试中继的环境变量（含测试令牌），绝不能进扩展包
.test-relay.env
.test-relay-state/**
.env
**/*.map
# 图标加工用的位图源文件（不打进扩展包）
111.png
# 本地方案与设计文档（docs/ 不入库，也不进扩展包）
docs/**
# DSH bundle 不属于 VS Code 扩展；其中可能含 .token / node_modules，绝不能进扩展包
dsh/**
# Android 客户端是独立工程（Gradle / SDK 缓存），不属于 VS Code 扩展
android/**
